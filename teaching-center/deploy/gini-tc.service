# systemd alternative to pm2. Use this one if the VM is managed by the school's sysadmins:
# it starts at boot without a per-user `pm2 startup`, and it survives the account being logged out.
#
#   sudo cp deploy/gini-tc.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now gini-tc
#   journalctl -u gini-tc -f
[Unit]
Description=GINI Teaching Center
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gini-tc
Group=gini-tc
WorkingDirectory=/opt/gini-tc
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/gini-tc/env
# TLS is required — there is no HTTP mode — so the certificate paths are part of the command, not
# an optional extra. Loopback still gets one: nginx proxies to https://127.0.0.1:8443 and does not
# verify an upstream certificate, so a self-signed cert made on the box is enough here. Behind
# nginx the REAL certificate stays with nginx, root-owned, and this process never sees it.
#
# To serve the public certificate from this process instead (README §5b), point --tls-cert at it,
# use --host 0.0.0.0, and note that an unprivileged unit cannot bind 443 without:
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
#
# If that certificate comes from Let's Encrypt, renewal does NOT reach a running process: the cert
# is read once at startup. Add a certbot hook, or the server silently serves an expired cert 90
# days in:
#   certbot renew --deploy-hook 'systemctl restart gini-tc'
ExecStart=/opt/gini-tc/venv/bin/gini-teaching-center --data /opt/gini-tc/data --port 8443 --host 127.0.0.1 \
    --tls-cert /opt/gini-tc/tls/gini.crt --tls-key /opt/gini-tc/tls/gini.key
Restart=always
RestartSec=2

# The database holds staff password hashes and every student's submitted work, on a VM the whole
# school can log into. These are the lines that keep it out of everyone else's reach.
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/gini-tc/data
# ProtectSystem=strict makes the filesystem read-only, not unreadable, so a certificate anywhere
# still loads — but the KEY must be readable by this user. Own it gini-tc:gini-tc mode 0600 in
# /opt/gini-tc/tls rather than loosening /etc/ssl/private, which the whole VM shares.
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
